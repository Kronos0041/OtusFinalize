rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasVerifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Демо-данные: читают только пользователи с подтверждённой почтой; пишет скрипт firebase/seed
    // (Admin SDK обходит правила).
    match /categories/{categoryId} {
      allow read: if hasVerifiedEmail();
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if hasVerifiedEmail();
      allow write: if false;
    }

    match /notificationList/{notificationId} {
      allow read: if hasVerifiedEmail();
      allow write: if false;
    }

    match /prof/{profileId} {
      allow read: if hasVerifiedEmail();
      allow write: if false;
    }
  }
}
